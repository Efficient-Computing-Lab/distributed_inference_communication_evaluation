<?xml version="1.0" encoding="UTF-8" ?>
<profiles xmlns="http://www.eprosima.com/XMLSchemas/fastrtps_profiles">
    <transport_descriptors>
        <transport_descriptor>
            <transport_id>huge_binary_transport</transport_id>
            <type>UDPv4</type>
            <maxMessageSize>65500</maxMessageSize>
            <sendBufferSize>2147483647</sendBufferSize>
            <receiveBufferSize>2147483647</receiveBufferSize>
            <non_blocking_send>true</non_blocking_send>
        </transport_descriptor>
    </transport_descriptors>

    <participant profile_name="huge_data_participant" is_default_profile="true">
        <rtps>
            <userTransports>
                <transport_id>huge_binary_transport</transport_id>
            </userTransports>
            <useBuiltinTransports>false</useBuiltinTransports>
        </rtps>
    </participant>

    <!-- Named profile: this won't be forced onto /rosout -->
    <data_writer profile_name="huge_data_profile">
        <qos>
            <publishMode>
                <kind>ASYNCHRONOUS</kind>
            </publishMode>
        </qos>
        <throughputController>
            <bytesPerPeriod>100000000</bytesPerPeriod>
            <periodMillisecs>10</periodMillisecs>
        </throughputController>
        <historyMemoryPolicy>PREALLOCATED_WITH_REALLOC</historyMemoryPolicy>
    </data_writer>

    <data_reader profile_name="huge_data_reader_profile">
        <historyMemoryPolicy>PREALLOCATED_WITH_REALLOC</historyMemoryPolicy>
    </data_reader>
</profiles>